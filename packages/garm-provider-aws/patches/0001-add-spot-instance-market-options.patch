+// SPDX-License-Identifier: Apache-2.0
+
+// Metacraft Labs downstream patch: guest metadata/callback URL overrides. No
+// mocks: ApplyGuestURLOverrides is a pure function of the config and the
+// bootstrap parameters.
+package config
+
+import (
+	"testing"
+
+	"github.com/cloudbase/garm-provider-common/params"
+	"github.com/stretchr/testify/require"
+)
+
+func TestApplyGuestURLOverrides(t *testing.T) {
+	in := params.BootstrapInstance{
+		MetadataURL: "http://10.0.0.1:9997/api/v1/metadata",
+		CallbackURL: "http://10.0.0.1:9997/api/v1/callbacks",
+	}
+
+	// Unset overrides keep the controller's URLs.
+	out := (&Config{}).ApplyGuestURLOverrides(in)
+	require.Equal(t, in.MetadataURL, out.MetadataURL)
+	require.Equal(t, in.CallbackURL, out.CallbackURL)
+
+	// Set overrides replace both.
+	c := &Config{
+		GuestMetadataURL: "https://garm.example.com/api/v1/metadata",
+		GuestCallbackURL: "https://garm.example.com/api/v1/callbacks",
+	}
+	out = c.ApplyGuestURLOverrides(in)
+	require.Equal(t, "https://garm.example.com/api/v1/metadata", out.MetadataURL)
+	require.Equal(t, "https://garm.example.com/api/v1/callbacks", out.CallbackURL)
+	// The input is not mutated.
+	require.Equal(t, "http://10.0.0.1:9997/api/v1/metadata", in.MetadataURL)
+}
