+//    Unless required by applicable law or agreed to in writing, software
+//    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+//    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+//    License for the specific language governing permissions and limitations
+//    under the License.
+
+// Metacraft Labs downstream spot patch — coverage for the EC2
+// InstanceMarketOptions (spot) support and the on-demand fallback policy added
+// to CreateRunningInstance. Drives the provider's OWN ClientInterface mock (the
+// seam upstream tests already use) to capture the RunInstancesInput and assert
+// what the provider renders — the same technique as aws_test.go's
+// TestCreateRunningInstance. No real AWS is touched. The mock is justified: it
+// is the provider's already-existing test seam for the EC2 API, and there is no
+// hermetic way to observe a real RunInstances request otherwise.
+package client
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/service/ec2"
+	"github.com/aws/aws-sdk-go-v2/service/ec2/types"
+	"github.com/cloudbase/garm-provider-aws/config"
+	"github.com/cloudbase/garm-provider-aws/internal/spec"
+	"github.com/cloudbase/garm-provider-common/params"
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+)
+
+func spotTestCli(mockClient *MockComputeClient) *AwsCli {
+	return &AwsCli{
+		cfg: &config.Config{
+			Region:   "us-west-2",
+			SubnetID: "subnet-1234567890abcdef0",
+			Credentials: config.Credentials{
+				CredentialType: config.AWSCredentialTypeStatic,
+				StaticCredentials: config.StaticCredentials{
+					AccessKeyID:     "AccessKeyID",
+					SecretAccessKey: "SecretAccessKey",
+					SessionToken:    "SessionToken",
+				},
+			},
+		},
+		client: mockClient,
+	}
+}
+
+func spotRunnerSpec() *spec.RunnerSpec {
+	spec.DefaultToolFetch = func(osType params.OSType, osArch params.OSArch, tools []params.RunnerApplicationDownload) (params.RunnerApplicationDownload, error) {
+		return params.RunnerApplicationDownload{
+			OS:           aws.String("linux"),
+			Architecture: aws.String("amd64"),
+			DownloadURL:  aws.String("MockURL"),
+			Filename:     aws.String("garm-runner"),
+		}, nil
+	}
+	return &spec.RunnerSpec{
+		Region: "us-west-2",
+		Tools: params.RunnerApplicationDownload{
+			OS:           aws.String("linux"),
+			Architecture: aws.String("amd64"),
+			DownloadURL:  aws.String("MockURL"),
+			Filename:     aws.String("garm-runner"),
+		},
+		BootstrapParams: params.BootstrapInstance{
+			Name:   "instance-name",
+			OSType: "linux",
+			Image:  "ami-12345678",
+			Flavor: "t3.medium",
+			PoolID: "poolID",
+		},
+		SubnetID:     "subnet-1234567890abcdef0",
+		ControllerID: "controllerID",
+	}
+}
+
+func describeImagesOK(mockClient *MockComputeClient) {
+	mockClient.On("DescribeImages", mock.Anything, mock.Anything, mock.Anything).Return(&ec2.DescribeImagesOutput{
+		Images: []types.Image{
+			{
+				ImageId:        aws.String("ami-12345678"),
+				RootDeviceName: aws.String("/dev/sda1"),
+			},
+		},
+	}, nil)
+}
+
+// A spot-eligible RunnerSpec renders RunInstances with InstanceMarketOptions
+// (MarketType=spot + SpotOptions), still as a one-job (MaxCount==MinCount==1)
+// launch.
+func TestCreateRunningInstanceSpotMarketOptions(t *testing.T) {
+	ctx := context.Background()
+	mockClient := new(MockComputeClient)
+	awsCli := spotTestCli(mockClient)
+	describeImagesOK(mockClient)
+
+	var captured *ec2.RunInstancesInput
+	mockClient.On("RunInstances", mock.Anything, mock.Anything, mock.Anything).
+		Run(func(args mock.Arguments) {
+			captured = args.Get(1).(*ec2.RunInstancesInput)
+		}).
+		Return(&ec2.RunInstancesOutput{
+			Instances: []types.Instance{{InstanceId: aws.String("i-spot0001")}},
+		}, nil)
+
+	rs := spotRunnerSpec()
+	maxPrice := "0.05"
+	rs.MarketType = "spot"
+	rs.SpotMaxPrice = maxPrice
+	rs.SpotInstanceType = "one-time"
+	rs.SpotInstanceInterruptionBehavior = "terminate"
+
+	id, err := awsCli.CreateRunningInstance(ctx, rs)
+	require.NoError(t, err)
+	require.Equal(t, "i-spot0001", id)
+
+	require.NotNil(t, captured, "RunInstances was not called")
+	require.NotNil(t, captured.InstanceMarketOptions, "spot spec must set InstanceMarketOptions")
+	require.Equal(t, types.MarketTypeSpot, captured.InstanceMarketOptions.MarketType)
+	require.NotNil(t, captured.InstanceMarketOptions.SpotOptions)
+	require.Equal(t, types.SpotInstanceTypeOneTime, captured.InstanceMarketOptions.SpotOptions.SpotInstanceType)
+	require.Equal(t, types.InstanceInterruptionBehaviorTerminate, captured.InstanceMarketOptions.SpotOptions.InstanceInterruptionBehavior)
+	require.NotNil(t, captured.InstanceMarketOptions.SpotOptions.MaxPrice)
+	require.Equal(t, maxPrice, *captured.InstanceMarketOptions.SpotOptions.MaxPrice)
+	// Ephemeral one-job auto-terminate: exactly one instance per Create.
+	require.Equal(t, int32(1), *captured.MaxCount)
+	// An OS power-off (the in-guest TTL backstop) must TERMINATE, never stop.
+	require.Equal(t, types.ShutdownBehaviorTerminate, captured.InstanceInitiatedShutdownBehavior)
+	requireVolumeOwnershipTags(t, captured)
+	require.Equal(t, int32(1), *captured.MinCount)
+}
+
+// An on-demand (unset MarketType) RunnerSpec must NOT set InstanceMarketOptions
+// — the negative control proving the patch is inert by default.
+func TestCreateRunningInstanceOnDemandNoMarketOptions(t *testing.T) {
+	ctx := context.Background()
+	mockClient := new(MockComputeClient)
+	awsCli := spotTestCli(mockClient)
+	describeImagesOK(mockClient)
+
+	var captured *ec2.RunInstancesInput
+	mockClient.On("RunInstances", mock.Anything, mock.Anything, mock.Anything).
+		Run(func(args mock.Arguments) {
+			captured = args.Get(1).(*ec2.RunInstancesInput)
+		}).
+		Return(&ec2.RunInstancesOutput{
+			Instances: []types.Instance{{InstanceId: aws.String("i-ond00001")}},
+		}, nil)
+
+	rs := spotRunnerSpec() // MarketType left empty
+	id, err := awsCli.CreateRunningInstance(ctx, rs)
+	require.NoError(t, err)
+	require.Equal(t, "i-ond00001", id)
+	require.NotNil(t, captured)
+	require.Nil(t, captured.InstanceMarketOptions, "on-demand launch must not carry InstanceMarketOptions")
+	// Ephemeral one-job auto-terminate: exactly one instance per Create, so a
+	// burst never over-provisions per queued job.
+	require.Equal(t, int32(1), *captured.MaxCount)
+	// An OS power-off (the in-guest TTL backstop) must TERMINATE, never stop.
+	require.Equal(t, types.ShutdownBehaviorTerminate, captured.InstanceInitiatedShutdownBehavior)
+	requireVolumeOwnershipTags(t, captured)
+	require.Equal(t, int32(1), *captured.MinCount)
+}
+
+// With on_demand_fallback=true, a spot capacity failure retries the SAME launch
+// on-demand: the second RunInstances call carries no InstanceMarketOptions and
+// the Create succeeds.
+func TestCreateRunningInstanceSpotOnDemandFallback(t *testing.T) {
+	ctx := context.Background()
+	mockClient := new(MockComputeClient)
+	awsCli := spotTestCli(mockClient)
+	describeImagesOK(mockClient)
+
+	// The provider reuses (mutates) the same RunInstancesInput pointer for the
+	// on-demand retry, so snapshot whether InstanceMarketOptions was set AT
+	// CALL TIME rather than retaining the pointer.
+	var marketOptsPresent []bool
+	// First (spot) call fails with a capacity error.
+	mockClient.On("RunInstances", mock.Anything, mock.Anything, mock.Anything).
+		Run(func(args mock.Arguments) {
+			marketOptsPresent = append(marketOptsPresent, args.Get(1).(*ec2.RunInstancesInput).InstanceMarketOptions != nil)
+		}).
+		Return((*ec2.RunInstancesOutput)(nil), errors.New("InsufficientInstanceCapacity: not enough spot capacity")).
+		Once()
+	// Second (on-demand) call succeeds.
+	mockClient.On("RunInstances", mock.Anything, mock.Anything, mock.Anything).
+		Run(func(args mock.Arguments) {
+			marketOptsPresent = append(marketOptsPresent, args.Get(1).(*ec2.RunInstancesInput).InstanceMarketOptions != nil)
+		}).
+		Return(&ec2.RunInstancesOutput{
+			Instances: []types.Instance{{InstanceId: aws.String("i-fallback01")}},
+		}, nil).
+		Once()
+
+	rs := spotRunnerSpec()
+	rs.MarketType = "spot"
+	rs.OnDemandFallback = true
+
+	id, err := awsCli.CreateRunningInstance(ctx, rs)
+	require.NoError(t, err)
+	require.Equal(t, "i-fallback01", id)
+	require.Len(t, marketOptsPresent, 2, "expected a spot attempt then an on-demand retry")
+	require.True(t, marketOptsPresent[0], "first attempt must be spot (InstanceMarketOptions set)")
+	require.False(t, marketOptsPresent[1], "fallback attempt must be on-demand (InstanceMarketOptions cleared)")
+}
+
+// Without on_demand_fallback, a spot capacity failure propagates (no retry).
+func TestCreateRunningInstanceSpotNoFallbackPropagates(t *testing.T) {
+	ctx := context.Background()
+	mockClient := new(MockComputeClient)
+	awsCli := spotTestCli(mockClient)
+	describeImagesOK(mockClient)
+
+	calls := 0
+	mockClient.On("RunInstances", mock.Anything, mock.Anything, mock.Anything).
+		Run(func(args mock.Arguments) { calls++ }).
+		Return((*ec2.RunInstancesOutput)(nil), errors.New("InsufficientInstanceCapacity: not enough spot capacity"))
+
+	rs := spotRunnerSpec()
+	rs.MarketType = "spot"
+	rs.OnDemandFallback = false
+
+	_, err := awsCli.CreateRunningInstance(ctx, rs)
+	require.Error(t, err)
+	require.Equal(t, 1, calls, "no fallback expected without on_demand_fallback")
+}
+
+// Graceful interruption handling at the provider layer: an interrupted spot
+// runner shows up as a terminated/shutting-down EC2 instance, which
+// FindInstances excludes from the live set — so GARM's DB-as-truth reconcile
+// sees the runner gone and re-queues the job. This asserts the state filter the
+// reconcile relies on.
+func TestFindInstancesExcludesInterruptedSpot(t *testing.T) {
+	ctx := context.Background()
+	mockClient := new(MockComputeClient)
+	awsCli := spotTestCli(mockClient)
+
+	var captured *ec2.DescribeInstancesInput
+	mockClient.On("DescribeInstances", mock.Anything, mock.Anything, mock.Anything).
+		Run(func(args mock.Arguments) {
+			captured = args.Get(1).(*ec2.DescribeInstancesInput)
+		}).
+		Return(&ec2.DescribeInstancesOutput{}, nil)
+
+	_, err := awsCli.FindInstances(ctx, "controllerID", "instance-name")
+	require.NoError(t, err)
+	require.NotNil(t, captured)
+
+	// The instance-state-name filter must exclude terminated + shutting-down
+	// (the two states an interrupted spot instance passes through) so the
+	// reconcile treats an interrupted runner as gone.
+	var stateValues []string
+	for _, f := range captured.Filters {
+		if f.Name != nil && *f.Name == "instance-state-name" {
+			stateValues = f.Values
+		}
+	}
+	require.NotEmpty(t, stateValues, "expected an instance-state-name filter")
+	require.NotContains(t, stateValues, "terminated")
+	require.NotContains(t, stateValues, "shutting-down")
+}
+
+// requireVolumeOwnershipTags asserts the launch tags the root volume with the
+// same GARM ownership keys as the instance, so a cloud-side reconcile can
+// attribute every billable resource a launch creates.
+func requireVolumeOwnershipTags(t *testing.T, in *ec2.RunInstancesInput) {
+	t.Helper()
+	for _, ts := range in.TagSpecifications {
+		if ts.ResourceType != types.ResourceTypeVolume {
+			continue
+		}
+		got := map[string]string{}
+		for _, tag := range ts.Tags {
+			got[*tag.Key] = *tag.Value
+		}
+		require.Equal(t, "poolID", got["GARM_POOL_ID"])
+		require.Equal(t, "controllerID", got["GARM_CONTROLLER_ID"])
+		require.Equal(t, "instance-name", got["Name"])
+		return
+	}
+	t.Fatal("RunInstances carries no volume TagSpecification")
+}
diff --git a/internal/spec/guest_url_userdata_test.go b/internal/spec/guest_url_userdata_test.go
