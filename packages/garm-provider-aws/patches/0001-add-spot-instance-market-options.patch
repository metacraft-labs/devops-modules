@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: Apache-2.0
+
+// Metacraft Labs downstream patch: the guest metadata/callback URL override
+// must reach the userdata the instance boots with. Only the runner-tool lookup
+// is stubbed (DefaultToolFetch, the same seam the upstream spec tests use):
+// it would otherwise need GitHub's runner download list.
+package spec
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/base64"
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/cloudbase/garm-provider-aws/config"
+	"github.com/cloudbase/garm-provider-common/params"
+	"github.com/stretchr/testify/require"
+)
+
+func userdataFor(t *testing.T, cfg *config.Config) string {
+	t.Helper()
+	DefaultToolFetch = func(params.OSType, params.OSArch, []params.RunnerApplicationDownload) (params.RunnerApplicationDownload, error) {
+		return params.RunnerApplicationDownload{
+			OS: aws.String("linux"), Architecture: aws.String("x64"),
+			DownloadURL: aws.String("https://example.invalid/runner.tgz"), Filename: aws.String("runner.tgz"),
+		}, nil
+	}
+	bp := params.BootstrapInstance{
+		Name: "garm-guesturl", OSType: params.Linux, OSArch: params.Amd64,
+		MetadataURL:   "http://100.64.0.1:9997/api/v1/metadata",
+		CallbackURL:   "http://100.64.0.1:9997/api/v1/callbacks",
+		InstanceToken: "token", ExtraSpecs: []byte(`{}`), Image: "ami-0123456789abcdef0", Flavor: "m6i.large",
+	}
+	bp = cfg.ApplyGuestURLOverrides(bp)
+	rs, err := GetRunnerSpecFromBootstrapParams(cfg, bp, "ctl")
+	require.NoError(t, err)
+	ud, err := rs.ComposeUserData()
+	require.NoError(t, err)
+	raw, err := base64.StdEncoding.DecodeString(ud)
+	require.NoError(t, err)
+	if len(raw) > 2 && raw[0] == 0x1f && raw[1] == 0x8b {
+		zr, err := gzip.NewReader(bytes.NewReader(raw))
+		require.NoError(t, err)
+		raw, err = io.ReadAll(zr)
+		require.NoError(t, err)
+	}
+	// cloud-config embeds the install script base64-encoded; expand every
+	// `content:` payload so the assertions see the script text.
+	out := string(raw)
+	for _, line := range strings.Split(string(raw), "\n") {
+		f := strings.TrimSpace(line)
+		if v, ok := strings.CutPrefix(f, "content: "); ok {
+			if dec, err := base64.StdEncoding.DecodeString(strings.Trim(v, "\"'")); err == nil {
+				out += "\n" + string(dec)
+			}
+		}
+	}
+	return out
+}
+
+func TestGuestURLOverrideReachesUserdata(t *testing.T) {
+	base := config.Config{SubnetID: "subnet-0123456789abcdef0", Region: "us-east-1"}
+
+	ud := userdataFor(t, &base)
+	require.True(t, strings.Contains(ud, "http://100.64.0.1:9997/api/v1/metadata"), "without an override the controller URL is used")
+
+	over := base
+	over.GuestMetadataURL = "https://garm.example.com/api/v1/metadata"
+	over.GuestCallbackURL = "https://garm.example.com/api/v1/callbacks"
+	ud = userdataFor(t, &over)
+	require.True(t, strings.Contains(ud, "https://garm.example.com/api/v1/metadata"))
+	require.True(t, strings.Contains(ud, "https://garm.example.com/api/v1/callbacks"))
+	require.False(t, strings.Contains(ud, "100.64.0.1"), "no controller-private URL may remain in the userdata")
+}
