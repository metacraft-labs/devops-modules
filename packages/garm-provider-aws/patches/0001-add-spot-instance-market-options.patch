+// Metacraft Labs downstream spot patch — proves the generated extra-specs JSON
+// schema (the contract GARM validates a pool's extra_specs against) advertises
+// the new spot / InstanceMarketOptions fields, so a pool requesting spot passes
+// validation and reaches the RunInstances path. No mock; this reflects the real
+// schema the shipped binary emits.
+package spec
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestExtraSpecsSchemaAdvertisesSpot(t *testing.T) {
+	schema := generateJSONSchema()
+	b, err := json.Marshal(schema)
+	require.NoError(t, err)
+	s := string(b)
+	for _, field := range []string{
+		"market_type",
+		"spot_max_price",
+		"spot_instance_type",
+		"spot_instance_interruption_behavior",
+		"on_demand_fallback",
+	} {
+		require.Contains(t, s, field, "extra-specs schema must advertise %q", field)
+	}
+	// The spot enum value must be present on market_type.
+	require.Contains(t, s, "spot")
+}
