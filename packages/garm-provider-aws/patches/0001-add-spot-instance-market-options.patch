+// applySpotMarketOptions sets EC2 InstanceMarketOptions (MarketType=spot plus
+// SpotOptions) on the RunInstances input from the runner spec. Added by the
+// Metacraft Labs downstream spot patch.
+func applySpotMarketOptions(input *ec2.RunInstancesInput, spec *spec.RunnerSpec) {
+	spotOpts := &types.SpotMarketOptions{}
+	if spec.SpotMaxPrice != "" {
+		spotOpts.MaxPrice = aws.String(spec.SpotMaxPrice)
+	}
+	switch strings.ToLower(spec.SpotInstanceType) {
+	case "persistent":
+		spotOpts.SpotInstanceType = types.SpotInstanceTypePersistent
+	default: // "one-time" or empty — the correct default for ephemeral runners.
+		spotOpts.SpotInstanceType = types.SpotInstanceTypeOneTime
+	}
+	switch strings.ToLower(spec.SpotInstanceInterruptionBehavior) {
+	case "stop":
+		spotOpts.InstanceInterruptionBehavior = types.InstanceInterruptionBehaviorStop
+	case "hibernate":
+		spotOpts.InstanceInterruptionBehavior = types.InstanceInterruptionBehaviorHibernate
+	default: // "terminate" or empty — the correct default for ephemeral runners.
+		spotOpts.InstanceInterruptionBehavior = types.InstanceInterruptionBehaviorTerminate
+	}
+	input.InstanceMarketOptions = &types.InstanceMarketOptionsRequest{
+		MarketType:  types.MarketTypeSpot,
+		SpotOptions: spotOpts,
+	}
+}
+
+// isSpotCapacityError reports whether err looks like an EC2 Spot
+// capacity/price rejection that an on-demand retry could satisfy. Added by the
+// Metacraft Labs downstream spot patch. Matched on the error string so it works
+// with both smithy API errors and wrapped errors without importing extra
+// modelled error types.
+func isSpotCapacityError(err error) bool {
+	if err == nil {
+		return false
+	}
+	msg := strings.ToLower(err.Error())
+	for _, s := range []string{
+		"insufficientinstancecapacity",
+		"insufficient capacity",
+		"spotmaxpricetoolow",
+		"maxspotinstancecountexceeded",
+		"unfulfillablecapacity",
+	} {
+		if strings.Contains(msg, s) {
+			return true
+		}
+	}
+	return false
+}
