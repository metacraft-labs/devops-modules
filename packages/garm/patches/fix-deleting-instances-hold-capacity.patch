+//	WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+//	License for the specific language governing permissions and limitations
+//	under the License.
+
+package capacity
+
+import (
+	"testing"
+
+	commonParams "github.com/cloudbase/garm-provider-common/params"
+
+	"github.com/cloudbase/garm/params"
+)
+
+func instances(statuses ...commonParams.InstanceStatus) []params.Instance {
+	out := make([]params.Instance, 0, len(statuses))
+	for _, s := range statuses {
+		out = append(out, params.Instance{Status: s})
+	}
+	return out
+}
+
+func repeat(s commonParams.InstanceStatus, n int) []commonParams.InstanceStatus {
+	out := make([]commonParams.InstanceStatus, n)
+	for i := range out {
+		out[i] = s
+	}
+	return out
+}
+
+func TestOccupied(t *testing.T) {
+	running := commonParams.InstanceRunning
+	creating := commonParams.InstanceCreating
+	pendingCreate := commonParams.InstancePendingCreate
+	errored := commonParams.InstanceError
+	pendingDelete := commonParams.InstancePendingDelete
+	deleting := commonParams.InstanceDeleting
+
+	cases := []struct {
+		name       string
+		statuses   []commonParams.InstanceStatus
+		maxRunners uint
+		want       int
+		wantLive   int
+	}{
+		{"empty", nil, 4, 0, 0},
+		{"live states all count", []commonParams.InstanceStatus{running, creating, pendingCreate, errored}, 4, 4, 4},
+		{
+			// The reported failure: a 4-runner pool whose 4 rows are stuck
+			// deleting must still be able to create runners.
+			"stuck deletes do not fill the pool",
+			[]commonParams.InstanceStatus{pendingDelete, deleting, deleting, commonParams.InstancePendingForceDelete},
+			4, 0, 0,
+		},
+		{"mixed", []commonParams.InstanceStatus{running, running, deleting, pendingDelete}, 4, 2, 2},
+		{
+			// Bound: at most maxRunners deleting rows are exempt, so a
+			// provider that never completes a delete holds <= 2 x maxRunners.
+			"deleting beyond the allowance counts",
+			repeat(deleting, 6),
+			4, 2, 0,
+		},
+		{"zero max exempts nothing", []commonParams.InstanceStatus{deleting, running}, 0, 2, 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			inst := instances(tc.statuses...)
+			if got := Occupied(inst, tc.maxRunners); got != tc.want {
+				t.Fatalf("Occupied = %d, want %d", got, tc.want)
+			}
+			if got := OccupiedStatuses(tc.statuses, tc.maxRunners); got != tc.want {
+				t.Fatalf("OccupiedStatuses = %d, want %d", got, tc.want)
+			}
+			if got := Live(inst); got != tc.wantLive {
+				t.Fatalf("Live = %d, want %d", got, tc.wantLive)
+			}
+		})
+	}
+}
+
+// With the bound, a pool can never hold more than 2 x maxRunners instances
+// on its provider, however many deletes fail.
+func TestOccupiedBoundsProviderFootprint(t *testing.T) {
+	const maxRunners = 3
+	var inst []params.Instance
+	for step := 0; step < 100; step++ {
+		if Occupied(inst, maxRunners) < maxRunners {
+			inst = append(inst, params.Instance{Status: commonParams.InstanceRunning})
+			continue
+		}
+		// Every running instance finishes its job and its delete never
+		// completes.
+		for i := range inst {
+			inst[i].Status = commonParams.InstanceDeleting
+		}
+	}
+	if len(inst) > 2*maxRunners {
+		t.Fatalf("provider footprint %d exceeds 2 x maxRunners (%d)", len(inst), 2*maxRunners)
+	}
+}
