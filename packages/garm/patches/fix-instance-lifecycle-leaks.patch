+// createRetryBackoff is how long an instance whose create failed stays in the
+// error state before retryFailedInstances re-queues it: 30s after the first
+// failure, doubling per attempt, capped at maxCreateRetryBackoff. With
+// maxCreateAttempts = 5 the attempts are spread over ~7.5 minutes instead of
+// the ~25 seconds a 5s consolidation tick allowed.
+func createRetryBackoff(createAttempt int) time.Duration {
+	if createAttempt < 1 {
+		createAttempt = 1
+	}
+	d := 30 * time.Second
+	for i := 1; i < createAttempt && d < maxCreateRetryBackoff; i++ {
+		d *= 2
+	}
+	return min(d, maxCreateRetryBackoff)
+}
+
+const maxCreateRetryBackoff = 20 * time.Minute
+
