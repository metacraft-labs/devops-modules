 	l.Require().NotNil(ib)
 	l.Require().NotEqual(time.Time{}, ib.lastRecordedFailureTime)
-	l.Require().Equal(7.5, ib.backoffSeconds)
+	l.Require().Equal(float64(10), ib.backoffSeconds)
 
 	l.locker.Delete("test")
 	mux, ok = l.locker.muxes.Load("test")
@@ -83,6 +83,47 @@ func (l *LockerBackoffTestSuite) TestRecordFailure() {
 	l.Require().Nil(mux)
 }
 
+// TestDoublingScheduleAndReset steps an injected clock through the delete
+// backoff: 5s doubling to the 20-minute cap, ShouldProcess refusing until each
+// deadline passes, and Delete (a successful delete) starting over at 5s.
+func (l *LockerBackoffTestSuite) TestDoublingScheduleAndReset() {
+	now := time.Date(2026, 11, 18, 12, 0, 0, 0, time.UTC)
+	b := NewInstanceDeleteBackoffWithClock(func() time.Time { return now })
+
+	want := []time.Duration{
+		5 * time.Second, 10 * time.Second, 20 * time.Second, 40 * time.Second,
+		80 * time.Second, 160 * time.Second, 320 * time.Second, 640 * time.Second,
+		20 * time.Minute, 20 * time.Minute,
+	}
+	for i, w := range want {
+		failures, got := b.RecordFailure("garm-x")
+		l.Require().Equal(i+1, failures)
+		l.Require().Equal(w, got, "step %d", i+1)
+
+		ok, deadline := b.ShouldProcess("garm-x")
+		l.Require().False(ok, "step %d: retried before the backoff elapsed", i+1)
+		l.Require().Equal(now.Add(w), deadline)
+		now = now.Add(w - time.Second)
+		ok, _ = b.ShouldProcess("garm-x")
+		l.Require().False(ok, "step %d: retried 1s before the deadline", i+1)
+		now = now.Add(2 * time.Second)
+		ok, _ = b.ShouldProcess("garm-x")
+		l.Require().True(ok, "step %d: still refused 1s after the deadline", i+1)
+	}
+
+	// Another key is independent.
+	ok, _ := b.ShouldProcess("garm-y")
+	l.Require().True(ok)
+
+	// Success resets the schedule.
+	b.Delete("garm-x")
+	ok, _ = b.ShouldProcess("garm-x")
+	l.Require().True(ok)
+	failures, got := b.RecordFailure("garm-x")
+	l.Require().Equal(1, failures)
+	l.Require().Equal(5*time.Second, got)
+}
+
 func TestBackoffTestSuite(t *testing.T) {
 	t.Parallel()
 	suite.Run(t, new(LockerBackoffTestSuite))
