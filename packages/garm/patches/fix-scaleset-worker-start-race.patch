+// refreshScaleSetLocked replaces our copy of the scale set with the one in
+// the database. Callers must hold w.mux.
+func (w *Worker) refreshScaleSetLocked() error {
+	scaleSet, err := w.store.GetScaleSetByID(w.ctx, w.scaleSet.ID)
+	if err != nil {
+		return fmt.Errorf("fetching scale set %d: %w", w.scaleSet.ID, err)
+	}
+	if scaleSet.Enabled != w.scaleSet.Enabled {
+		slog.InfoContext(
+			w.ctx, "scale set changed while the worker was starting",
+			"scale_set", w.consumerID, "enabled", scaleSet.Enabled)
+	}
+	w.scaleSet = scaleSet
+	return nil
+}
