+//    Unless required by applicable law or agreed to in writing, software
+//    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+//    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+//    License for the specific language governing permissions and limitations
+//    under the License.
+
+package metrics
+
+import (
+	"strings"
+	"sync"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+// gaugeSnapshot collects the complete new contents of a GaugeVec and then
+// replaces the published series with them.
+//
+// The collectors used to call Reset() on a vector and then query the
+// database to fill it again. A scrape that arrived between the two saw the
+// family empty: no runners, no jobs, no pools. Under database load that gap
+// lasts as long as the slowest list query. A snapshot never empties the
+// vector. It sets every new series first and then deletes the series that
+// are no longer current. A scrape can catch the brief union of old and new
+// series, which costs a few in-memory map operations rather than a database
+// round trip. If a collector returns before Publish, for example because a
+// list query failed, the previous values stay published.
+type gaugeSnapshot struct {
+	vec     *prometheus.GaugeVec
+	samples map[string]gaugeSample
+}
+
+type gaugeSample struct {
+	labels []string
+	value  float64
+}
+
+var (
+	publishedMu sync.Mutex
+	// published holds the label values each vector exported at its last
+	// Publish, keyed the same way as gaugeSnapshot.samples.
+	published = map[*prometheus.GaugeVec]map[string][]string{}
+)
+
+func newGaugeSnapshot(vec *prometheus.GaugeVec) *gaugeSnapshot {
+	return &gaugeSnapshot{vec: vec, samples: map[string]gaugeSample{}}
+}
+
+// labelKey joins label values with a byte that cannot occur in valid UTF-8.
+func labelKey(labels []string) string {
+	return strings.Join(labels, "\xff")
+}
+
+// Set records a sample. A later Set with the same label values overwrites it.
+func (s *gaugeSnapshot) Set(value float64, labels ...string) {
+	s.samples[labelKey(labels)] = gaugeSample{labels: labels, value: value}
+}
+
+// Publish makes the recorded samples the vector's only series.
+func (s *gaugeSnapshot) Publish() {
+	publishedMu.Lock()
+	defer publishedMu.Unlock()
+
+	next := make(map[string][]string, len(s.samples))
+	for key, sample := range s.samples {
+		s.vec.WithLabelValues(sample.labels...).Set(sample.value)
+		next[key] = sample.labels
+	}
+
+	// Only snapshots write these vectors, so the previous publish names
+	// every series that can be stale.
+	prev := published[s.vec]
+	for key, labels := range prev {
+		if _, ok := next[key]; !ok {
+			s.vec.DeleteLabelValues(labels...)
+		}
+	}
+	published[s.vec] = next
+}
diff --git a/runner/metrics/snapshot_test.go b/runner/metrics/snapshot_test.go
new file mode 100644
index 00000000..3a5501ca
--- /dev/null
+++ b/runner/metrics/snapshot_test.go
@@ -0,0 +1,163 @@
+// Copyright 2026 Cloudbase Solutions SRL
+//
+//    Licensed under the Apache License, Version 2.0 (the "License"); you may
+//    not use this file except in compliance with the License. You may obtain
+//    a copy of the License at
+//
+//         http://www.apache.org/licenses/LICENSE-2.0
