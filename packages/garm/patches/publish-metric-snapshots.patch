+//    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+//    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+//    License for the specific language governing permissions and limitations
+//    under the License.
+
+package metrics
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/stretchr/testify/require"
+)
+
+func newTestVec(t *testing.T) (*prometheus.GaugeVec, *prometheus.Registry) {
+	t.Helper()
+	vec := prometheus.NewGaugeVec(prometheus.GaugeOpts{
+		Name: "test_status",
+		Help: "test",
+	}, []string{"name", "status"})
+	reg := prometheus.NewRegistry()
+	require.NoError(t, reg.Register(vec))
+	return vec, reg
+}
+
+// series returns "name/status=value" for every exported series, sorted.
+func series(t *testing.T, reg *prometheus.Registry) []string {
+	t.Helper()
+	families, err := reg.Gather()
+	require.NoError(t, err)
+	var out []string
+	for _, family := range families {
+		for _, m := range family.GetMetric() {
+			labels := map[string]string{}
+			for _, l := range m.GetLabel() {
+				labels[l.GetName()] = l.GetValue()
+			}
+			out = append(out, fmt.Sprintf("%s/%s=%g", labels["name"], labels["status"], m.GetGauge().GetValue()))
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func TestGaugeSnapshotReplacesSeries(t *testing.T) {
+	vec, reg := newTestVec(t)
+
+	first := newGaugeSnapshot(vec)
+	first.Set(1, "a", "running")
+	first.Set(1, "b", "running")
+	first.Publish()
+	require.Equal(t, []string{"a/running=1", "b/running=1"}, series(t, reg))
+
+	// b changes status, a goes away, c appears.
+	second := newGaugeSnapshot(vec)
+	second.Set(1, "b", "deleting")
+	second.Set(2, "c", "running")
+	second.Publish()
+	require.Equal(t, []string{"b/deleting=1", "c/running=2"}, series(t, reg))
+}
+
+func TestGaugeSnapshotKeepsPreviousSeriesUntilPublish(t *testing.T) {
+	vec, reg := newTestVec(t)
+
+	first := newGaugeSnapshot(vec)
+	first.Set(1, "a", "running")
+	first.Publish()
+
+	// A collector fills a snapshot and then fails, so it never publishes.
+	// That is the state a scrape sees while a list query is in flight, and
+	// the state left behind when the query errors: the previous values.
+	pending := newGaugeSnapshot(vec)
+	pending.Set(1, "b", "running")
+	require.Equal(t, []string{"a/running=1"}, series(t, reg))
+}
+
+func TestGaugeSnapshotEmptyPublishClears(t *testing.T) {
+	vec, reg := newTestVec(t)
+
+	first := newGaugeSnapshot(vec)
+	first.Set(1, "a", "running")
+	first.Publish()
+
+	// A successful query that returns nothing does clear the family.
+	newGaugeSnapshot(vec).Publish()
+	require.Empty(t, series(t, reg))
+}
+
+func TestGaugeSnapshotLastSetWins(t *testing.T) {
+	vec, reg := newTestVec(t)
+
+	snap := newGaugeSnapshot(vec)
+	snap.Set(1, "a", "running")
+	snap.Set(3, "a", "running")
+	snap.Publish()
+	require.Equal(t, []string{"a/running=3"}, series(t, reg))
+}
+
+// TestGaugeSnapshotScrapeNeverSeesEmptyFamily refreshes a vector of 50 series
+// continuously while another goroutine gathers it. With Reset() followed by a
+// refill, the gatherer catches the family empty. With snapshots it never does.
+func TestGaugeSnapshotScrapeNeverSeesEmptyFamily(t *testing.T) {
+	vec, reg := newTestVec(t)
+
+	publish := func(round int) {
+		snap := newGaugeSnapshot(vec)
+		for i := 0; i < 50; i++ {
+			status := "idle"
+			if (i+round)%3 == 0 {
+				status = "active"
+			}
+			snap.Set(1, fmt.Sprintf("runner-%d", i), status)
+		}
+		snap.Publish()
+	}
+	publish(0)
+
+	var stop atomic.Bool
+	var emptyScrapes atomic.Int64
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for !stop.Load() {
+			families, err := reg.Gather()
+			if err != nil {
+				panic(err)
+			}
+			n := 0
+			for _, family := range families {
+				if strings.HasSuffix(family.GetName(), "test_status") {
+					n += len(family.GetMetric())
+				}
+			}
+			if n == 0 {
+				emptyScrapes.Add(1)
+			}
+		}
+	}()
+
+	for round := 1; round <= 2000; round++ {
+		publish(round)
+	}
+	stop.Store(true)
+	wg.Wait()
+
+	require.Zero(t, emptyScrapes.Load(), "a scrape saw the family empty")
+	require.Len(t, series(t, reg), 50)
+}
