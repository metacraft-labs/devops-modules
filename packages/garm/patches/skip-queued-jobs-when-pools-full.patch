+
+// fullPools records, for one consumeQueuedJobs pass, the pools that refused a
+// runner with ErrNoCapacity. Within a pass a pool only gains runners, so a
+// full pool stays full until the next pass re-checks it.
+type fullPools map[string]bool
+
+// coversAll reports whether no pool in pools could take a runner this pass:
+// each is disabled or already refused one.
+func (f fullPools) coversAll(pools []params.Pool) bool {
+	if len(pools) == 0 {
+		return false
+	}
+	for _, pool := range pools {
+		if pool.Enabled && !f[pool.ID] {
+			return false
+		}
+	}
+	return true
+}
diff --git a/runner/pool/pool_test.go b/runner/pool/pool_test.go
index 2fe1c81a..0edc929b 100644
--- a/runner/pool/pool_test.go
+++ b/runner/pool/pool_test.go
@@ -907,3 +907,96 @@ func mustParseUUID(s string) uuid.UUID {
 func TestPoolStressTestSuite(t *testing.T) {
 	suite.Run(t, new(PoolStressTestSuite))
 }
+
+// TestConsumeQueuedJobsSkipsJobsWhenEveryPoolIsFull pins the fix for GARM's
+// API stalls on high-mem-server (2026-10-14). With a backlog of queued jobs
+// behind pools that were all at max_runners, every consumeQueuedJobs pass
+// locked each job, tried every pool and unlocked it again: two write
+// transactions per job per pass on SQLite's single connection, thousands a
+// minute, so webhooks and API requests waited minutes behind them and the
+// watchdog restarted garm.service. A pass with no free capacity must leave
+// every job after the first untouched in the store.
+func (s *PoolStressTestSuite) TestConsumeQueuedJobsSkipsJobsWhenEveryPoolIsFull() {
+	s.setupProviderMocks()
+
+	maxRunners := uint(1)
+	minIdle := uint(1)
+	pool, err := s.store.UpdateEntityPool(s.adminCtx, s.entity, s.pool.ID, params.UpdatePoolParams{
+		MaxRunners:     &maxRunners,
+		MinIdleRunners: &minIdle,
+	})
+	s.Require().NoError(err)
+	s.pool = pool
+	cache.SetEntityPool(s.entity.ID, pool)
+
+	// Fill the pool.
+	s.Require().NoError(s.mgr.ensureIdleRunnersForOnePool(pool))
+	count, err := s.store.PoolInstanceCount(s.adminCtx, pool.ID)
+	s.Require().NoError(err)
+	s.Require().EqualValues(1, count)
+
+	labels := []string{"self-hosted", "linux", "x64"}
+	for i := range 5 {
+		job := s.makeWorkflowJob(int64(4001+i), "queued", "queued", "", labels)
+		s.Require().NoError(s.mgr.HandleWorkflowJob(job))
+	}
+	s.mgr.controllerInfo.MinimumJobAgeBackoff = 0
+	s.syncJobsFromDB()
+
+	before, err := s.store.ListJobsByStatus(s.adminCtx, params.JobStatusQueued)
+	s.Require().NoError(err)
+	s.Require().Len(before, 5)
+	updatedBefore := map[int64]time.Time{}
+	for _, j := range before {
+		updatedBefore[j.WorkflowJobID] = j.UpdatedAt
+	}
+
+	// Let any write that does happen get a distinct updated_at.
+	time.Sleep(20 * time.Millisecond)
+	s.Require().NoError(s.mgr.consumeQueuedJobs())
+
+	after, err := s.store.ListJobsByStatus(s.adminCtx, params.JobStatusQueued)
+	s.Require().NoError(err)
+	s.Require().Len(after, 5)
+	written := 0
+	for _, j := range after {
+		if !j.UpdatedAt.Equal(updatedBefore[j.WorkflowJobID]) {
+			written++
+		}
+		s.Equal(uuid.Nil, j.LockedBy, "job %d left locked", j.WorkflowJobID)
+	}
+	// The first job discovers that the pool is full (one lock/try/unlock);
+	// every later job in the pass must be skipped without a write.
+	s.LessOrEqual(written, 1,
+		"%d of 5 jobs were written to although their only pool was full (lock/unlock churn)", written)
+	count, err = s.store.PoolInstanceCount(s.adminCtx, pool.ID)
+	s.Require().NoError(err)
+	s.EqualValues(1, count, "no runner may be created above max_runners")
+}
+
+// TestConsumeQueuedJobsStillFillsFreeCapacity: the pre-check must not stop a
+// pass from using capacity that exists, nor over-fill it within one pass.
+func (s *PoolStressTestSuite) TestConsumeQueuedJobsStillFillsFreeCapacity() {
+	s.setupProviderMocks()
+
+	maxRunners := uint(2)
+	pool, err := s.store.UpdateEntityPool(s.adminCtx, s.entity, s.pool.ID, params.UpdatePoolParams{
+		MaxRunners: &maxRunners,
+	})
+	s.Require().NoError(err)
+	s.pool = pool
+	cache.SetEntityPool(s.entity.ID, pool)
+
+	labels := []string{"self-hosted", "linux", "x64"}
+	for i := range 4 {
+		job := s.makeWorkflowJob(int64(4101+i), "queued", "queued", "", labels)
+		s.Require().NoError(s.mgr.HandleWorkflowJob(job))
+	}
+	s.mgr.controllerInfo.MinimumJobAgeBackoff = 0
+	s.syncJobsFromDB()
+	s.Require().NoError(s.mgr.consumeQueuedJobs())
+
+	count, err := s.store.PoolInstanceCount(s.adminCtx, pool.ID)
+	s.Require().NoError(err)
+	s.EqualValues(2, count, "both free slots used, none beyond max_runners")
+}
