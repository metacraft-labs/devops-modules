#!/usr/bin/env python3
"""Refuse to run tofu against a root whose `github` provider has no credential.

Usage:
  github-provider-credential-gate WORKING_DIRECTORY [--github-app-owner OWNER]

Reads the environment variable GITHUB_TOKEN (what the reusable workflow's
github-app minting step exports) and the root's `metadata.json` and rendered
`*.tf.json` / `*.tf` files.

Exit status:
  0  the root does not use the github provider, or it does and has a credential
  3  the root uses the github provider and would run without a credential
  2  usage error, or a file that must parse does not

Why this exists (2026-09-24): a caller of reusable-terraform-ci.yml forwarded
its matrix row without `github_app_owner` and without the GH_APP_* secrets, so
the App-token step was skipped and GITHUB_TOKEN was never set. The
integrations/github provider does not fail in that case: it falls back to
`gh auth token`, and then to ANONYMOUS mode (60 requests/hour per source IP).
Its RateLimitTransport answers a primary rate-limit 403 by sleeping until the
reset time and retrying the same request, with the message logged only at
WARN. A governance root refreshes hundreds of objects, so the plan slept for
hours printing nothing and the job had to be cancelled. Failing here, before
init, turns that into a one-line error.

Two checks, both of which must pass:

  metadata   `credential_mode: github-app` in metadata.json means the caller
             must pass `github_app_owner` (the matrix row carries it). An empty
             owner means the minting step was skipped: that is a caller wiring
             bug, reported as such.
  provider   any `provider "github"` block with neither `token` nor `app_auth`
             reads GITHUB_TOKEN from the environment. It must be non-empty.

Pure standard library: runs under any python3 with no environment.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from pathlib import Path

_HCL_PROVIDER = re.compile(r'^\s*provider\s+"github"\s*\{', re.MULTILINE)
_HCL_CREDENTIAL = re.compile(r"^\s*(token\s*=|app_auth\s*\{)", re.MULTILINE)


def _provider_blocks(document: object) -> list[dict]:
    """Every `github` provider block in one .tf.json document.

    The JSON syntax allows `provider.github` to be an object or a list of
    objects (aliases), and `provider` itself to be a list of such maps.
    """
    providers = document.get("provider") if isinstance(document, dict) else None
    maps = providers if isinstance(providers, list) else [providers]
    blocks: list[dict] = []
    for entry in maps:
        if not isinstance(entry, dict) or "github" not in entry:
            continue
        github = entry["github"]
        for block in github if isinstance(github, list) else [github]:
            blocks.append(block if isinstance(block, dict) else {})
    return blocks


def _has_inline_credential(block: dict) -> bool:
    return bool(block.get("token")) or bool(block.get("app_auth"))


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("working_directory")
    parser.add_argument("--github-app-owner", default="")
    args = parser.parse_args(argv)

    root = Path(args.working_directory)
    if not root.is_dir():
        print(f"::error::Not a directory: {root}", file=sys.stderr)
        return 2

    problems: list[str] = []

    metadata_path = root / "metadata.json"
    if metadata_path.is_file():
        try:
            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            print(f"::error::Cannot parse {metadata_path}: {error}", file=sys.stderr)
            return 2
        if metadata.get("credential_mode") == "github-app":
            expected = metadata.get("github_app_owner") or ""
            if not args.github_app_owner:
                problems.append(
                    f"{metadata_path} declares credential_mode github-app "
                    f"(github_app_owner {expected!r}), but the workflow was called "
                    "with an empty github_app_owner, so no App token was minted. "
                    "Pass `github_app_owner: ${{ matrix.github_app_owner }}` and the "
                    "GH_APP_ID / GH_APP_PRIVATE_KEY secrets from the caller."
                )
            elif expected and args.github_app_owner != expected:
                problems.append(
                    f"github_app_owner {args.github_app_owner!r} does not match "
                    f"{metadata_path} github_app_owner {expected!r}."
                )

    uncredentialed: list[str] = []
    for path in sorted(root.glob("*.tf.json")):
        try:
            document = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            print(f"::error::Cannot parse {path}: {error}", file=sys.stderr)
            return 2
        if any(not _has_inline_credential(b) for b in _provider_blocks(document)):
            uncredentialed.append(path.name)
    for path in sorted(root.glob("*.tf")):
        text = path.read_text(encoding="utf-8")
        # Coarse on purpose: a .tf file that declares the provider without any
        # token/app_auth line anywhere in it relies on the environment.
        if _HCL_PROVIDER.search(text) and not _HCL_CREDENTIAL.search(text):
            uncredentialed.append(path.name)

    if uncredentialed and not os.environ.get("GITHUB_TOKEN", "").strip():
        problems.append(
            "the github provider in "
            + ", ".join(uncredentialed)
            + " has no token/app_auth and GITHUB_TOKEN is empty. The provider "
            "would fall back to anonymous access (60 requests/hour) and sleep "
            "silently on every rate-limit reset instead of failing."
        )

    for problem in problems:
        print(f"::error::{problem}", file=sys.stderr)
    if problems:
        return 3

    print("github provider credential gate: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
