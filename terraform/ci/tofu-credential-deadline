#!/usr/bin/env bash
# tofu-credential-deadline — stop OpenTofu while its credentials still work.
#
# WHY
#
# Every credential a Terraform CI job holds is short-lived: a GitHub App
# installation token lives 1 h, and the AWS OIDC session lives
# `aws_role_duration_seconds` (1 h by default). Nothing tells tofu that. On
# 2026-10-01 a governance-root apply (metacraft-labs/infra run 36860633451)
# spent 66 minutes refreshing ~4,600 objects; the App token expired mid-refresh
# (`401 Bad credentials` on every remaining read), and when tofu then tried to
# release its DynamoDB state lock, the AWS session had expired too
# (`ExpiredTokenException`). The lock stayed behind and refused every later
# apply until someone ran `force-unlock` by hand.
#
# OpenTofu releases its lock on any orderly exit, including an interrupt. So
# the fix is to interrupt it ourselves, early enough that the release still
# has a valid credential: run tofu under `timeout --signal=INT`, with the
# deadline derived from when the credentials were minted, minus a margin that
# covers the graceful shutdown (and the SIGKILL fallback after it).
#
# USAGE
#
#   tofu-credential-deadline not-after --github-app true|false \
#       --aws-duration SECONDS|'' [--now EPOCH]
#     Print the epoch second at which the first credential minted NOW expires
#     (empty when the job mints none). Call it BEFORE minting, so the estimate
#     errs early.
#
#   tofu-credential-deadline run [--not-after EPOCH|''] [--margin S]
#       [--kill-after S] [--min-runtime S] -- COMMAND [ARGS...]
#     Run COMMAND, interrupting it (SIGINT) at NOT_AFTER - MARGIN and killing
#     it KILL_AFTER seconds later. Refuses to start (exit 75) when less than
#     MIN_RUNTIME seconds would remain: starting a lock-taking command that
#     cannot finish is how a lock gets stranded. An empty NOT_AFTER runs
#     COMMAND unbounded. Exit status is COMMAND's, or 124 when interrupted.
set -euo pipefail

die() {
  echo "tofu-credential-deadline: $*" >&2
  exit 64
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

# GitHub documents installation access tokens as expiring after one hour.
readonly GITHUB_APP_TOKEN_LIFETIME=3600

cmd_not_after() {
  local github_app="false" aws_duration="" now=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --github-app) github_app="${2-}"; shift 2 ;;
      --aws-duration) aws_duration="${2-}"; shift 2 ;;
      --now) now="${2-}"; shift 2 ;;
      *) die "not-after: unknown argument: $1" ;;
    esac
  done
  [ -n "$now" ] || now="$(date +%s)"
  is_uint "$now" || die "not-after: --now must be an epoch second"
  local not_after=""
  case "$github_app" in
    true) not_after=$((now + GITHUB_APP_TOKEN_LIFETIME)) ;;
    false | "") ;;
    *) die "not-after: --github-app must be true or false" ;;
  esac
  if [ -n "$aws_duration" ]; then
    is_uint "$aws_duration" || die "not-after: --aws-duration must be seconds"
    local aws=$((now + aws_duration))
    if [ -z "$not_after" ] || [ "$aws" -lt "$not_after" ]; then
      not_after="$aws"
    fi
  fi
  printf '%s\n' "$not_after"
}

cmd_run() {
  local not_after="" margin=600 kill_after=240 min_runtime=300
  while [ $# -gt 0 ]; do
    case "$1" in
      --not-after) not_after="${2-}"; shift 2 ;;
      --margin) margin="${2-}"; shift 2 ;;
      --kill-after) kill_after="${2-}"; shift 2 ;;
      --min-runtime) min_runtime="${2-}"; shift 2 ;;
      --) shift; break ;;
      *) die "run: unknown argument: $1" ;;
    esac
  done
  [ $# -gt 0 ] || die "run: no command given (expected: run [options] -- COMMAND...)"
  for v in "$margin" "$kill_after" "$min_runtime"; do
    is_uint "$v" || die "run: --margin, --kill-after and --min-runtime must be seconds"
  done
  [ "$kill_after" -lt "$margin" ] ||
    die "run: --kill-after ($kill_after) must be below --margin ($margin), or the SIGKILL lands after the credentials expire"

  if [ -z "$not_after" ]; then
    exec "$@"
  fi
  is_uint "$not_after" || die "run: --not-after must be an epoch second or empty"

  local now budget
  now="$(date +%s)"
  budget=$((not_after - margin - now))
  if [ "$budget" -lt "$min_runtime" ]; then
    echo "::error::Refusing to start '$1': the job's credentials expire in $((not_after - now))s, leaving ${budget}s before the ${margin}s safety margin (minimum ${min_runtime}s). Starting a command that takes the state lock and cannot finish is what strands a lock. Re-run the job to mint fresh credentials."
    exit 75
  fi

  echo "tofu-credential-deadline: credentials valid until $(date -u -d "@$not_after" +%FT%TZ 2>/dev/null || echo "$not_after"); interrupting after ${budget}s (SIGINT), killing ${kill_after}s later." >&2
  local rc=0
  timeout --signal=INT --kill-after="$kill_after" "$budget" "$@" || rc=$?
  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    echo "::error::'$1' was still running ${margin}s before the job's credentials expire, so it was interrupted (SIGINT) while they still work: OpenTofu finishes the operations in flight, writes state and releases its lock on an interrupt. The usual cause is a refresh that makes more API calls than fit in the credential lifetime; see the root's API-budget notes."
    exit 124
  fi
  return "$rc"
}

[ $# -gt 0 ] || die "usage: tofu-credential-deadline not-after|run ..."
sub="$1"
shift
case "$sub" in
  not-after) cmd_not_after "$@" ;;
  run) cmd_run "$@" ;;
  *) die "unknown subcommand: $sub" ;;
esac
