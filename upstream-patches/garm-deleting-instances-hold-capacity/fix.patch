+// TestStuckDeletesDoNotConsumePoolCapacity covers a provider whose deletes
+// stall: instances that sit in pending_delete/deleting are already gone from
+// the forge and must not keep the pool at max_runners. The bound still
+// applies: deleting instances beyond max_runners do count.
+func (s *PoolStressTestSuite) TestStuckDeletesDoNotConsumePoolCapacity() {
+	s.setupProviderMocks()
+
+	maxRunners := uint(2)
+	pool, err := s.store.UpdateEntityPool(s.adminCtx, s.entity, s.pool.ID, params.UpdatePoolParams{
+		MaxRunners: &maxRunners,
+	})
+	s.Require().NoError(err)
+	s.pool = pool
+	cache.SetEntityPool(s.entity.ID, pool)
+
+	fill := func() {
+		for range maxRunners {
+			s.Require().NoError(s.mgr.addRunnerToPool(pool, nil))
+		}
+		err := s.mgr.addRunnerToPool(pool, nil)
+		s.Require().Error(err, "a full pool must refuse a runner")
+	}
+	markLiveDeleting := func() {
+		instances, err := s.store.ListPoolInstances(s.adminCtx, pool.ID, false)
+		s.Require().NoError(err)
+		for _, inst := range instances {
+			if inst.Status != commonParams.InstancePendingCreate {
+				continue
+			}
+			for _, st := range []commonParams.InstanceStatus{commonParams.InstancePendingDelete, commonParams.InstanceDeleting} {
+				_, err := s.store.UpdateInstance(s.adminCtx, inst.Name, params.UpdateInstanceParams{Status: st})
+				s.Require().NoError(err)
+			}
+		}
+	}
+
+	fill()
+	// Every delete stalls.
+	markLiveDeleting()
+	// The pool can serve again despite max_runners rows in the table.
+	fill()
+
+	// A second round of stalled deletes exceeds the allowance: the excess
+	// counts, so the pool is full with no live runner and the provider
+	// footprint stays at 2 x max_runners.
+	markLiveDeleting()
+	err = s.mgr.addRunnerToPool(pool, nil)
+	s.Require().Error(err)
+	instances, err := s.store.ListPoolInstances(s.adminCtx, pool.ID, false)
+	s.Require().NoError(err)
+	s.Require().Len(instances, int(2*maxRunners))
+}
