+// Package capacity decides which instances occupy a runner slot of a pool or
+// scale set, i.e. which ones count against its MaxRunners.
+package capacity
+
+import (
+	commonParams "github.com/cloudbase/garm-provider-common/params"
+
+	garmErrors "github.com/cloudbase/garm/internal/errors"
+	"github.com/cloudbase/garm/params"
+)
+
+// Occupied returns how many of instances count against maxRunners.
+//
+// An instance whose provider resource is confirmed gone (deleted) never
+// counts: its row only awaits database cleanup.
+//
+// An instance on the deletion lane (pending_delete, pending_force_delete,
+// deleting) has already been removed from the forge. It can never
+// take a job again. It stays in the table only until the provider confirms
+// the teardown. If that teardown keeps failing, counting the row would
+// quietly shrink the pool: a provider whose deletes stall for hours (a busy
+// storage backend, for example) would leave a pool of N runners with none it
+// can use.
+//
+// Such instances therefore do not count, up to maxRunners of them. Deleting
+// instances beyond that DO count. That bounds what a pool can hold on its
+// provider at 2 x maxRunners even when no delete ever succeeds, so a provider
+// whose deletes are permanently broken cannot turn "exclude deleting
+// instances" into unbounded creation.
+func Occupied(instances []params.Instance, maxRunners uint) int {
+	live, deleting := Split(instances)
+	return live + excessDeleting(deleting, maxRunners)
+}
+
+// OccupiedStatuses is Occupied over bare instance statuses, for callers that
+// read only the status column (the database's own MaxRunners check).
+func OccupiedStatuses(statuses []commonParams.InstanceStatus, maxRunners uint) int {
+	live, deleting := 0, 0
+	for _, s := range statuses {
+		if s == commonParams.InstanceDeleted {
+			continue
+		}
+		if IsBeingDeleted(s) {
+			deleting++
+		} else {
+			live++
+		}
+	}
+	return live + excessDeleting(deleting, maxRunners)
+}
+
+// Live returns how many instances are not on the deletion lane.
+func Live(instances []params.Instance) int {
+	live, _ := Split(instances)
+	return live
+}
+
+// Split returns how many instances are not on the deletion lane (live) and
+// how many are still on it (deleting). Instances already deleted are in
+// neither.
+func Split(instances []params.Instance) (live, deleting int) {
+	for _, inst := range instances {
+		if inst.Status == commonParams.InstanceDeleted {
+			continue
+		}
+		if IsBeingDeleted(inst.Status) {
+			deleting++
+		} else {
+			live++
+		}
+	}
+	return live, deleting
+}
+
+// IsBeingDeleted reports whether an instance status is on the deletion lane.
+func IsBeingDeleted(s commonParams.InstanceStatus) bool {
+	return garmErrors.InstanceIsBeingDeleted(s)
+}
+
+func excessDeleting(deleting int, maxRunners uint) int {
+	allowance := int(min(maxRunners, uint(1<<31-1)))
+	if deleting > allowance {
+		return deleting - allowance
+	}
+	return 0
+}
