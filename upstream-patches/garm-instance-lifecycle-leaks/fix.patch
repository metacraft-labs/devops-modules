+// createRetryBackoff is how long an instance whose create failed stays in the
+// error state before retryFailedInstances re-queues it: 30s after the first
+// failure, doubling per attempt, capped at maxCreateRetryBackoff. With
+// maxCreateAttempts = 5 the attempts are spread over ~7.5 minutes instead of
+// the ~25 seconds a 5s consolidation tick allowed.
+func createRetryBackoff(createAttempt int) time.Duration {
+	if createAttempt < 1 {
+		createAttempt = 1
+	}
+	d := 30 * time.Second
+	for i := 1; i < createAttempt && d < maxCreateRetryBackoff; i++ {
+		d *= 2
+	}
+	return min(d, maxCreateRetryBackoff)
+}
+
+const maxCreateRetryBackoff = 20 * time.Minute
+
+// retryFailedBackoffKey is the backoff entry retryFailedInstancesForOnePool
+// keeps for an instance whose cleanup delete failed. It is removed when that
+// delete succeeds, when the instance runs out of create attempts, and when the
+// instance record is deleted — the backoff store is an in-memory map, and an
+// entry nothing removes is kept for the life of the process.
+func retryFailedBackoffKey(instanceName string) string {
+	return "retry-failed/" + instanceName
+}
+
 func (r *basePoolManager) retryFailedInstancesForOnePool(ctx context.Context, pool params.Pool) error {
 	if !pool.Enabled {
 		return nil
@@ -1427,12 +1491,34 @@ func (r *basePoolManager) retryFailedInstancesForOnePool(ctx context.Context, po
 		return fmt.Errorf("failed to list instances for pool %s: %w", pool.ID, err)
 	}
 
-	g, errCtx := errgroup.WithContext(ctx)
+	// A plain errgroup, NOT errgroup.WithContext: with a shared cancellable
+	// context the FIRST failing provider delete cancelled every sibling delete
+	// of the pool mid-flight (the provider binary is SIGKILLed), and the
+	// returned error aborted the pass. One unreachable provider host thus
+	// turned into a storm of killed deletes against every other host, retried
+	// every PoolConsilitationInterval (5s). Failures are now per instance:
+	// logged, backed off, and never allowed to cancel their siblings.
+	g := new(errgroup.Group)
 	for _, instance := range existingInstances {
 		if instance.Status != commonParams.InstanceError {
 			continue
 		}
+		retryKey := retryFailedBackoffKey(instance.Name)
 		if instance.CreateAttempt >= maxCreateAttempts {
+			// Never retried again: drop any delete backoff it still holds.
+			r.backoff.Delete(retryKey)
+			continue
+		}
+		if wait := createRetryBackoff(instance.CreateAttempt); time.Since(instance.UpdatedAt) < wait {
+			// Back off between create attempts. Without this, a create that
+			// fails fast (a full storage pool, a broken image) was retried
+			// every 5s, burning all attempts in well under a minute and then
+			// being replaced by a fresh instance that did the same.
+			continue
+		}
+		if ok, _ := r.backoff.ShouldProcess(retryKey); !ok {
+			// A previous cleanup delete of this instance failed; wait out
+			// its backoff instead of hammering the provider every tick.
 			continue
 		}
 
@@ -1456,19 +1542,19 @@ func (r *basePoolManager) retryFailedInstancesForOnePool(ctx context.Context, po
 			// NOTE(gabriel-samfira): this is done in parallel. If there are many failed instances
 			// this has the potential to create many API requests to the target provider.
 			// TODO(gabriel-samfira): implement request throttling.
-			if err := r.deleteInstanceFromProvider(errCtx, instance); err != nil {
+			if err := r.deleteInstanceFromProvider(ctx, instance); err != nil {
 				slog.With(slog.Any("error", err)).ErrorContext(
 					ctx, "failed to delete instance from provider",
 					"runner_name", instance.Name)
-				// Bail here, otherwise we risk creating multiple failing instances, and losing track
-				// of them. If Create instance failed to return a proper provider ID, we rely on the
-				// name to delete the instance. If we don't bail here, and end up with multiple
-				// instances with the same name, using the name to clean up failed instances will fail
-				// on any subsequent call, unless the external or native provider takes into account
-				// non unique names and loops over all of them. Something which is extremely hacky and
-				// which we would rather avoid.
-				return err
+				// Do not requeue: otherwise we risk creating multiple failing instances, and losing
+				// track of them. If Create instance failed to return a proper provider ID, we rely on
+				// the name to delete the instance; with duplicate names that cleanup could no longer
+				// be addressed. The instance stays in error and is retried after a backoff. The
+				// failure is NOT returned: that would cancel sibling deletes (see above).
+				r.backoff.RecordFailure(retryKey)
+				return nil
 			}
+			r.backoff.Delete(retryKey)
 			slog.DebugContext(
 				ctx, "cleanup of previously failed instance complete",
 				"runner_name", instance.Name)
@@ -1670,6 +1756,7 @@ func (r *basePoolManager) deletePendingInstances() error {
 					// We can use it as a marker to signal that the backoff is no longer
 					// needed.
