index eef79a6c..94849b17 100644
--- a/runner/pool/util.go
+++ b/runner/pool/util.go
@@ -16,6 +16,7 @@ package pool
 
 import (
 	"context"
+	"errors"
 	"fmt"
 	"log/slog"
 	"net/http"
@@ -109,6 +110,53 @@ func (r *basePoolManager) getQueuedJobs() []params.Job {
 	return ret
 }
 
+// refreshCachedJob re-reads a job this manager has just written to (locked or
+// unlocked) and stores the result in the in-memory cache.
+//
+// The cache is otherwise fed only by watcher notifications. If one of those
+// is lost, or arrives after a later one, the cache disagrees with the store,
+// and consumeQueuedJobs() trusts the cache. Writing our own changes through
+// keeps it correct regardless. The copy comes from the store, so its
+// timestamps are the store's. A job that is no longer in the cache (the
+// watcher retired it) is never re-added.
+func (r *basePoolManager) refreshCachedJob(job params.Job) {
+	fresh, err := r.store.GetJobByID(r.ctx, job.WorkflowJobID)
+	if err != nil {
+		if errors.Is(err, runnerErrors.ErrNotFound) {
+			r.forgetCachedJob(job.ID)
+			return
+		}
+		slog.With(slog.Any("error", err)).WarnContext(
+			r.ctx, "failed to refresh cached job",
+			"job_id", job.WorkflowJobID)
+		return
+	}
+
+	r.mux.Lock()
+	defer r.mux.Unlock()
+	if _, ok := r.jobs[fresh.ID]; !ok {
+		return
+	}
+	if r.jobUpdateIsStale(fresh) {
+		return
+	}
+	if params.JobStatus(fresh.Status) == params.JobStatusCompleted {
+		r.retireJob(fresh)
+		return
+	}
+	r.jobs[fresh.ID] = fresh
+}
+
+// forgetCachedJob removes a job from the in-memory cache after the store
+// reported that it no longer exists.
+func (r *basePoolManager) forgetCachedJob(id int64) {
+	r.mux.Lock()
+	defer r.mux.Unlock()
+
+	delete(r.jobs, id)
+	r.jobTombstones[id] = time.Now()
+}
+
 func (r *basePoolManager) waitForToolsOrCancel() (hasTools, stopped bool) {
 	ticker := time.NewTicker(1 * time.Second)
 	defer ticker.Stop()
