+// seedJobCache replaces the manager's in-memory job cache with the given jobs,
+// keyed the way the watcher keys them in production (the job record ID).
+func (s *PoolStressTestSuite) seedJobCache(jobs ...params.Job) {
+	s.mgr.mux.Lock()
+	defer s.mgr.mux.Unlock()
+	for k := range s.mgr.jobs {
+		delete(s.mgr.jobs, k)
+	}
+	for _, j := range jobs {
+		s.mgr.jobs[j.ID] = j
+	}
+}
+
+func (s *PoolStressTestSuite) queuedJobByWorkflowID(workflowJobID int64) params.Job {
+	queued, err := s.store.ListJobsByStatus(s.adminCtx, params.JobStatusQueued)
+	s.Require().NoError(err)
+	for _, j := range queued {
+		if j.WorkflowJobID == workflowJobID {
+			return j
+		}
+	}
+	s.FailNow("queued job not found", "workflow_job_id %d", workflowJobID)
+	return params.Job{}
+}
+
+// TestConsumeQueuedJobsRecoversFromStaleLockInCache reproduces a queued job
+// being abandoned forever. The manager locks the job, fails to place it (the
+// pools are at capacity) and unlocks it. If the watcher notification for the
+// unlock is lost, or delivered before the notification for the lock, the cached
+// copy keeps "locked by us" while the store says "unlocked". The 10 minute
+// retry then calls UnlockJob, which is a no-op on an unlocked record and sends
+// no notification, so the cache is never corrected and the job is skipped on
+// every pass, even after capacity frees up.
+func (s *PoolStressTestSuite) TestConsumeQueuedJobsRecoversFromStaleLockInCache() {
+	s.setupProviderMocks()
+	s.mgr.controllerInfo.MinimumJobAgeBackoff = 0
+
+	_, err := s.store.CreateOrUpdateJob(s.adminCtx, params.Job{
+		WorkflowJobID:   8001,
+		Action:          "queued",
+		Status:          "queued",
+		Labels:          []string{"self-hosted", "linux", "x64"},
+		RepositoryName:  "test-repo",
+		RepositoryOwner: "test-owner",
+		RepoID:          garmTesting.Ptr(mustParseUUID(s.entity.ID)),
+	})
+	s.Require().NoError(err)
+
+	// The store has the job queued and unlocked. The cache holds the copy
+	// from the reordered lock notification: locked by us, last touched more
+	// than 10 minutes ago.
+	stored := s.queuedJobByWorkflowID(8001)
+	s.Require().Equal(uuid.Nil, stored.LockedBy)
+	cached := stored
+	cached.LockedBy = mustParseUUID(s.mgr.ID())
+	cached.UpdatedAt = time.Now().UTC().Add(-11 * time.Minute)
+	s.seedJobCache(cached)
+
+	s.Require().NoError(s.mgr.consumeQueuedJobs())
+
+	instances, err := s.store.ListPoolInstances(s.adminCtx, s.pool.ID, false)
+	s.Require().NoError(err)
+	s.Len(instances, 1, "a runner must be created for the job once its stale cached lock has expired")
+
+	s.Equal(mustParseUUID(s.mgr.ID()), s.queuedJobByWorkflowID(8001).LockedBy,
+		"the job must be locked in the store by the pass that served it")
+}
+
+// TestConsumeQueuedJobsDropsGhostJobs checks that a cached job which no longer
+// exists in the store (its delete notification was lost) is dropped from the
+// cache, and does not stop the pass from serving the jobs after it.
+func (s *PoolStressTestSuite) TestConsumeQueuedJobsDropsGhostJobs() {
+	s.setupProviderMocks()
+	s.mgr.controllerInfo.MinimumJobAgeBackoff = 0
+
+	_, err := s.store.CreateOrUpdateJob(s.adminCtx, params.Job{
+		WorkflowJobID:   8202,
+		Action:          "queued",
+		Status:          "queued",
+		Labels:          []string{"self-hosted", "linux", "x64"},
+		RepositoryName:  "test-repo",
+		RepositoryOwner: "test-owner",
+		RepoID:          garmTesting.Ptr(mustParseUUID(s.entity.ID)),
+	})
+	s.Require().NoError(err)
+	real := s.queuedJobByWorkflowID(8202)
+
+	ghost := real
+	ghost.ID = real.ID + 1000
+	ghost.WorkflowJobID = 8201
+	ghost.UpdatedAt = time.Now().UTC().Add(-time.Minute)
+	s.seedJobCache(ghost, real)
+
+	s.Require().NoError(s.mgr.consumeQueuedJobs())
+
+	s.mgr.mux.Lock()
+	_, ghostCached := s.mgr.jobs[ghost.ID]
+	s.mgr.mux.Unlock()
+	s.False(ghostCached, "a job missing from the store must be dropped from the cache")
+
+	instances, err := s.store.ListPoolInstances(s.adminCtx, s.pool.ID, false)
+	s.Require().NoError(err)
+	s.Len(instances, 1, "the real job must still be served")
+}
+
 func mustParseUUID(s string) uuid.UUID {
 	u, err := uuid.Parse(s)
 	if err != nil {
