--- a/runner/pool/pool.go
+++ b/runner/pool/pool.go
@@ -2224,6 +2224,13 @@ func (r *basePoolManager) consumeQueuedJobs() error {
 			// was spawned. Unlock it and try again. A different job may have picked up
 			// the runner.
 			if err := r.store.UnlockJob(r.ctx, job.WorkflowJobID, r.ID()); err != nil {
+				if errors.Is(err, runnerErrors.ErrNotFound) {
+					// The job is gone from the store, but the notification
+					// that would have removed it from our cache never
+					// arrived. Drop the ghost entry.
+					r.forgetCachedJob(job.ID)
+					continue
+				}
 				// nolint:golangci-lint,godox
 				// TODO: Implament a cache? Should we return here?
 				slog.With(slog.Any("error", err)).ErrorContext(
@@ -2231,6 +2238,16 @@ func (r *basePoolManager) consumeQueuedJobs() error {
 					"job_id", job.WorkflowJobID)
 				continue
 			}
+			// UnlockJob() is a silent no-op (no change, no watcher
+			// notification) when the record is already unlocked. If the
+			// notification of an earlier unlock was lost or reordered behind
+			// the lock that preceded it, our cached copy still says "locked
+			// by us" while the store says "unlocked", and nothing would ever
+			// correct it: the check below would skip this job forever. The
+			// store is the source of truth and it is now unlocked, so take
+			// that into the cache and retry the job in this pass.
+			job.LockedBy = uuid.Nil
+			r.refreshCachedJob(job)
 		}
 
 		if job.LockedBy.String() == r.ID() {
@@ -2263,11 +2280,19 @@ func (r *basePoolManager) consumeQueuedJobs() error {
 
 		runnerCreated := false
 		if err := r.store.LockJob(r.ctx, job.WorkflowJobID, r.ID()); err != nil {
+			if errors.Is(err, runnerErrors.ErrNotFound) {
+				// Deleted from the store; the delete notification never
+				// reached our cache. Drop the ghost entry.
+				r.forgetCachedJob(job.ID)
+				continue
+			}
 			slog.With(slog.Any("error", err)).ErrorContext(
 				r.ctx, "could not lock job",
 				"job_id", job.WorkflowJobID)
 			continue
 		}
+		// Write the lock through to the cache (see refreshCachedJob).
+		r.refreshCachedJob(job)
 
 		jobLabels := []string{
 			fmt.Sprintf("%s=%d", jobLabelPrefix, job.WorkflowJobID),
@@ -2309,11 +2334,24 @@ func (r *basePoolManager) consumeQueuedJobs() error {
 				r.ctx, "could not create a runner for job; unlocking",
 				"job_id", job.WorkflowJobID)
 			if err := r.store.UnlockJob(r.ctx, job.WorkflowJobID, r.ID()); err != nil {
+				if errors.Is(err, runnerErrors.ErrNotFound) {
+					// The job completed or was removed while we were
+					// trying to serve it. Nothing left to unlock, and no
+					// reason to abandon the rest of the queue.
+					r.forgetCachedJob(job.ID)
+					continue
+				}
 				slog.With(slog.Any("error", err)).ErrorContext(
 					r.ctx, "failed to unlock job",
 					"job_id", job.WorkflowJobID)
 				return fmt.Errorf("error unlocking job: %w", err)
 			}
+			// Write the unlock through to the cache rather than relying on
+			// the watcher notification alone. If that notification is lost,
+			// or overtaken by the notification of the lock we took above,
+			// the cache keeps the job "locked by us" and this manager would
+			// not look at it again for at least 10 minutes.
+			r.refreshCachedJob(job)
 		}
 	}
 	return nil
diff --git a/runner/pool/pool_test.go b/runner/pool/pool_test.go
