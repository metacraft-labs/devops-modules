From 517ff9f67ec1b60046cbd6cd2c69464a4a56897c Mon Sep 17 00:00:00 2001
From: Zahary Karadjov <zahary@metacraft-labs.com>
Date: Wed, 18 Nov 2026 02:07:13 +0200
Subject: [PATCH] Re-read the scale set after the worker subscribes to updates

A scale set worker is built from a copy of its scale set that the
controller loaded earlier, and Worker.Start() only registers its watcher
consumer after ensureScaleSetInGitHub() has talked to the forge. An
update committed in that window is published before the worker is
subscribed, so the worker never sees it. Repeating the same update does
not help: the row does not change, so no event is published.

The visible case is enabling a scale set while GARM is starting. The
worker keeps Enabled=false in memory, keepListenerAlive() parks without
opening a message session, and nothing is logged at info level. Jobs for
the scale set queue until GARM is restarted.

Re-read the scale set from the database once the consumer is registered.
A write now lands either before that read or as an event. Log at info
level when a worker starts with its scale set disabled, and when an
update enables or disables it, so a parked worker is visible.

The test enables the scale set from the fake forge while Start() is in
ensureScaleSetInGitHub(), which reproduces the window deterministically.
Without the re-read it fails: the worker keeps the disabled copy and
never asks for a message session.

Signed-off-by: Zahary Karadjov <zahary@metacraft-labs.com>
---
 workers/scaleset/scaleset.go                  |  38 +++++
 .../scaleset_worker_update_race_test.go       | 160 ++++++++++++++++++
 2 files changed, 198 insertions(+)
 create mode 100644 workers/scaleset/scaleset_worker_update_race_test.go

diff --git a/workers/scaleset/scaleset.go b/workers/scaleset/scaleset.go
index 87319d52..8aa03c77 100644
--- a/workers/scaleset/scaleset.go
+++ b/workers/scaleset/scaleset.go
@@ -363,6 +363,21 @@ func (w *Worker) Start() (err error) {
 		}
 	}()
 
+	// Our copy of the scale set was read before we subscribed (it is the row
+	// the controller loaded, possibly long before this worker was started),
+	// and the watcher only delivers changes made after RegisterConsumer. An
+	// update committed in between, for example the scale set being enabled
+	// while ensureScaleSetInGitHub() talked to the forge, would never reach
+	// this worker: repeating the same update changes nothing in the database,
+	// so no further event is sent. Re-read the scale set now that we are
+	// subscribed. Anything committed after this read arrives as an event.
+	if err := w.refreshScaleSetLocked(); err != nil {
+		return fmt.Errorf("refreshing scale set: %w", err)
+	}
+	if !w.scaleSet.Enabled {
+		slog.InfoContext(w.ctx, "scale set is disabled; the listener will not start until it is enabled", "scale_set", w.consumerID)
+	}
+
 	slog.DebugContext(w.ctx, "creating scale set listener")
 	listener := newListener(w.ctx, w)
 
@@ -380,6 +395,22 @@ func (w *Worker) Start() (err error) {
 	return nil
 }
 
+// refreshScaleSetLocked replaces our copy of the scale set with the one in
+// the database. Callers must hold w.mux.
+func (w *Worker) refreshScaleSetLocked() error {
+	scaleSet, err := w.store.GetScaleSetByID(w.ctx, w.scaleSet.ID)
+	if err != nil {
+		return fmt.Errorf("fetching scale set %d: %w", w.scaleSet.ID, err)
+	}
+	if scaleSet.Enabled != w.scaleSet.Enabled {
+		slog.InfoContext(
+			w.ctx, "scale set changed while the worker was starting",
+			"scale_set", w.consumerID, "enabled", scaleSet.Enabled)
+	}
+	w.scaleSet = scaleSet
+	return nil
+}
+
 func (w *Worker) runnerByName() map[string]params.Instance {
 	runners := make(map[string]params.Instance)
 	for _, runner := range w.runners {
@@ -782,6 +813,13 @@ func (w *Worker) handleScaleSetEvent(event dbCommon.ChangePayload) {
 		slog.DebugContext(w.ctx, "got update operation")
 		w.mux.Lock()
 
+		if scaleSet.Enabled != w.scaleSet.Enabled {
+			if scaleSet.Enabled {
+				slog.InfoContext(w.ctx, "scale set enabled; starting the listener", "scale_set", w.consumerID)
+			} else {
+				slog.InfoContext(w.ctx, "scale set disabled; stopping the listener", "scale_set", w.consumerID)
+			}
+		}
 		if scaleSet.MaxRunners < w.scaleSet.MaxRunners || !scaleSet.Enabled {
 			// we stop the listener if the scale set is disabled or if the max runners
 			// is decreased. In the case where max runners changes but the scale set
diff --git a/workers/scaleset/scaleset_worker_update_race_test.go b/workers/scaleset/scaleset_worker_update_race_test.go
new file mode 100644
index 00000000..a551874e
--- /dev/null
+++ b/workers/scaleset/scaleset_worker_update_race_test.go
@@ -0,0 +1,160 @@
+// Copyright 2026 Cloudbase Solutions SRL
