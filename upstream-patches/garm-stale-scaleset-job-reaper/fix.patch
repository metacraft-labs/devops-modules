+// jobIsGoneOnForge asks the forge whether a job GARM still believes is queued
+// is in fact still queued there.
+//
+// There are two kinds of job row and they must be addressed differently:
+//
+//   - webhook/pool jobs carry a workflow job ID, so the job itself can be
+//     fetched;
+//   - scale set jobs never populate WorkflowJobID. The runner-scale-set
+//     message protocol identifies a job by a UUID that has no REST endpoint,
+//     so the finest granularity available is the workflow RUN. A run that has
+//     completed cannot have a job of that run still queued, which is exactly
+//     the condition this reconciler exists to clean up. Anything short of
+//     "completed" (queued, in_progress, waiting, requested, pending, ...) is
+//     treated as still live, so a genuinely queued job is never reaped.
+//
+// It returns gone=true when the row should be deleted, and a non-nil error
+// only when the forge could not be consulted.
+func (r *basePoolManager) jobIsGoneOnForge(job params.Job) (bool, string, error) {
+	if job.WorkflowJobID > 0 {
+		ghJob, ghResp, err := r.ghcli.GetWorkflowJobByID(r.ctx, job.RepositoryOwner, job.RepositoryName, job.WorkflowJobID)
+		if err != nil {
+			if ghResp != nil && ghResp.StatusCode == http.StatusNotFound {
+				return true, "job no longer exists on GitHub", nil
+			}
+			return false, "", err
+		}
+		if ghJob.GetStatus() != "queued" {
+			return true, fmt.Sprintf("job is no longer queued on GitHub (status %q)", ghJob.GetStatus()), nil
+		}
+		return false, "", nil
+	}
+
+	if job.RunID == 0 {
+		return false, "", fmt.Errorf("job has neither a workflow job ID nor a run ID")
+	}
+
+	ghRun, ghResp, err := r.ghcli.GetWorkflowRunByID(r.ctx, job.RepositoryOwner, job.RepositoryName, job.RunID)
+	if err != nil {
+		if ghResp != nil && ghResp.StatusCode == http.StatusNotFound {
+			return true, "workflow run no longer exists on GitHub", nil
+		}
+		return false, "", err
+	}
+	if ghRun.GetStatus() == "completed" {
+		return true, fmt.Sprintf("workflow run has completed on GitHub (conclusion %q)", ghRun.GetConclusion()), nil
+	}
+	return false, "", nil
+}
